# GitHub 제출 저장소: 소스, 제출 APK, README만 올린다.
/*
!/.gitignore
!/README.md
!/android-app/
!/apk/
/apk/*
!/apk/SA_페달체크_release.apk
/android-app/*.md
/android-app/apk/
/android-app/evidence/

# 빌드 산출물과 로컬 설정
.DS_Store
**/local.properties
**/.gradle/
**/.kotlin/
**/.idea/
**/build/
__pycache__/
*.pyc

# 서명 키와 비밀 값
*.jks
*.keystore
*.pem
*.p12
*.key
*.pfx
*.idsig
.env
.env.*
keystore.properties
